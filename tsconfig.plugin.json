{
  // The Claude Code adapter as the engine runs it: no Node, no DOM. The
  // engine lays this build's API types into .claude-plugin/types/ each time
  // it loads the plugin (claude --plugin-dir .); they are not committed.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [".claude-plugin/types", "core", "adapters/claude-code"]
}

{
  // The hooks module as the engine runs it: no Node, no DOM. Extends the
  // config the engine lays into .claude-plugin/types/ on each load
  // (claude --plugin-dir .); those types are not committed.
  "extends": "./.claude-plugin/types/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "typeRoots": ["./.claude-plugin/types"]
  },
  "include": [".claude-plugin/types", "hooks", "types", "tests/**/*.test.ts"]
}
